# Copy this file to .env in the project root. Expo does not load .env.example.
# Physical devices: use your computer's current Wi-Fi IP and the backend port.
# Keep the phone and computer on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.100.130:5000

# To use the hosted backend instead, set this value in .env:
# EXPO_PUBLIC_API_URL=https://rideit-8cl7.onrender.com
